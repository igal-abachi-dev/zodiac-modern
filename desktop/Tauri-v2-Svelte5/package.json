{
  "name": "neutronstar-tauri-svelte5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": { "node": ">=24.21.0 <25" },
  "scripts": {
    "dev": "pnpm build:design && vite",
    "build:design": "node scripts/build-design.mjs",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "tsx --test tests/domain.test.ts tests/workload-model.test.ts",
    "build": "pnpm typecheck && pnpm build:design && vite build && node scripts/audit-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle --target x86_64-pc-windows-msvc"
  },
  "dependencies": {
    "svelte": "5.57.2",
    "@ark-ui/svelte": "5.24.3",
    "nanostores": "1.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte-check": "4.7.7",
    "vite": "8.3.4",
    "typescript": "6.0.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/cli": "4.3.3",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-hebrew": "5.3.0",
    "lucide-static": "1.58.0",
    "tsx": "4.23.15"
  }
}
