<?xml version="1.0" ?>
<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="using:NeutronStar.AvaloniaApp.Controls" xmlns:vm="using:NeutronStar.AvaloniaApp.ViewModels" x:Class="NeutronStar.AvaloniaApp.MainWindow" x:DataType="vm:MainViewModel" Title="NeutronStar GUI Bench" Width="960" Height="640" MinWidth="360" MinHeight="400">
  <Grid>
    <ScrollViewer x:Name="PageScroll" IsEnabled="{Binding MainEnabled}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28" MaxWidth="1044" Spacing="20">
        <Grid x:Name="HeaderGrid" ColumnDefinitions="*,Auto" RowSpacing="12">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Background="#F1F4F2" BorderBrush="#DCE3DE" BorderThickness="1" CornerRadius="8" Width="40" Height="40">
                <icons:LucideIcon Kind="orbit" Width="20" Height="20"/>
              </Border>
              <TextBlock Text="NeutronStar GUI Bench" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Text="A UI-only simulation for comparing desktop frontends." Classes="muted" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <Button x:Name="AboutTrigger" Grid.Column="1" Command="{Binding AboutCommand}" AutomationProperties.Name="About this test" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:LucideIcon Kind="info"/>
              <TextBlock Text="About this test"/>
            </StackPanel>
          </Button>
        </Grid>
        <Border HorizontalAlignment="Left" Background="#F1F4F2" BorderBrush="#DCE3DE" BorderThickness="1" CornerRadius="6" Padding="9,7">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <icons:LucideIcon Kind="shield-check" Width="14" Height="14"/>
            <TextBlock FontSize="10" FontWeight="SemiBold" Text="SIMULATION · NO FILES OR CRYPTOGRAPHY."/>
          </StackPanel>
        </Border>
        <Grid x:Name="Cards" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="20">
          <Border x:Name="DecryptCard" Classes="card">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <icons:LucideIcon Kind="unlock-keyhole"/>
                <TextBlock Text="Decrypt" FontSize="16" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock Classes="eyebrow" Text="SYNTHETIC INPUT"/>
              <Border Classes="fixture">
                <StackPanel Spacing="5">
                  <TextBlock Text="Synthetic sample: starlight.nsx"/>
                  <TextBlock Classes="muted" FontSize="12" Text="No disk file is opened."/>
                </StackPanel>
              </Border>
              <Button Classes="action" AutomationProperties.AutomationId="decrypt" AutomationProperties.Name="Simulate decryption" Command="{Binding DecryptCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <icons:LucideIcon Kind="arrow-down-to-line" Stroke="#171A18"/>
                  <TextBlock Text="Simulate decryption"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border x:Name="EncryptCard" Grid.Column="1" Classes="card">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <icons:LucideIcon Kind="lock-keyhole"/>
                <TextBlock Text="Encrypt" FontSize="16" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock Classes="eyebrow" Text="SYNTHETIC INPUT"/>
              <Border Classes="fixture">
                <TextBlock Text="{Binding FixtureText}" TextWrapping="Wrap"/>
              </Border>
              <Button Classes="action primary" AutomationProperties.AutomationId="encrypt" AutomationProperties.Name="Simulate encryption" Command="{Binding EncryptCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <icons:LucideIcon Kind="arrow-up-from-line" Stroke="White"/>
                  <TextBlock Text="Simulate encryption"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
        <Border Classes="card">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#047857"/>
                <TextBlock x:Name="StatusText" Text="{Binding Status}" AutomationProperties.AutomationId="status" AutomationProperties.LiveSetting="Polite" FontWeight="Medium"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button IsVisible="{Binding Running}" Content="Cancel" Command="{Binding CancelCommand}"/>
                <Button Content="Reset" Command="{Binding ResetCommand}"/>
              </StackPanel>
            </Grid>
            <StackPanel Spacing="8">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6" Foreground="#047857" Background="#F1F4F2" AutomationProperties.Name="Simulation progress"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Simulation progress" Classes="muted" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="{Binding Percent}" Classes="muted" FontSize="11"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
        <Grid x:Name="FooterGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" RowSpacing="10">
          <Button x:Name="OpenWorkbenchButton" Content="Open workbench" Command="{Binding OpenWorkbenchCommand}" HorizontalAlignment="Left"/>
          <TextBlock x:Name="PrivacyText" Grid.Column="1" Text="Local interface. Synthetic data. Nothing is encrypted or decrypted." Classes="muted" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <TextBlock x:Name="RendererText" Grid.Column="2" Text="CONTROLLED RENDERER · LOCAL STATE" Classes="muted" FontSize="9" VerticalAlignment="Center"/>
        </Grid>
        <Border x:Name="WorkbenchSection" IsVisible="{Binding HasWorkbench}" BorderBrush="#DCE3DE" BorderThickness="0,1,0,0" Padding="0,24,0,0">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="List and filter workbench" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Deterministic synthetic rows. No files, network, cryptography or native commands." Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Back to main screen" Command="{Binding BackCommand}"/>
            </Grid>
            <ContentControl Content="{Binding Workbench}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:WorkbenchViewModel" x:DataType="vm:WorkbenchViewModel">
                  <StackPanel Spacing="16">
                    <TextBlock Text="{Binding ReadyStatus}"/>
                    <WrapPanel Classes="workbench-actions">
                      <Button Content="1,000 rows" Command="{Binding Replace1000Command}"/>
                      <Button Content="10,000 rows" Command="{Binding Replace10000Command}"/>
                      <Button Content="Reverse" Command="{Binding ReverseCommand}"/>
                      <Button Content="Splice 10" Command="{Binding SpliceCommand}"/>
                      <Button Content="Update 10%" Command="{Binding UpdateCommand}"/>
                      <Button Content="10 Hz / 2 s" Command="{Binding Burst10Command}"/>
                      <Button Content="30 Hz / 2 s" Command="{Binding Burst30Command}"/>
                      <Button Content="60 Hz / 2 s" Command="{Binding Burst60Command}"/>
                      <Button Content="Stop" Command="{Binding StopCommand}"/>
                      <Button Content="Remount workload" Command="{Binding RemountCommand}"/>
                    </WrapPanel>
                    <Border Classes="card">
                      <StackPanel Spacing="10">
                        <TextBlock Text="Filter synthetic rows"/>
                        <TextBox Text="{Binding Query,Mode=TwoWay}" AutomationProperties.Name="Filter synthetic rows" AutomationProperties.AutomationId="workload-query"/>
                        <TextBlock Text="{Binding Summary}" AutomationProperties.AutomationId="workload-summary"/>
                        <TextBlock Text="Case-sensitive label filtering. Replacement advances row IDs; remount resets IDs, query and tick." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding VisibleRows}" AutomationProperties.Name="Synthetic rows" AutomationProperties.AutomationId="workload-rows">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:Row">
                          <Border BorderBrush="#DCE3DE" BorderThickness="1,0,1,1" Background="White" Padding="12,6">
                            <TextBlock Text="{Binding Display}"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border x:Name="DialogOverlay" IsVisible="{Binding AboutOpen}" Background="#66000000" Padding="20">
      <Border x:Name="AboutCard" Background="White" BorderBrush="#DCE3DE" BorderThickness="1" CornerRadius="12" Padding="24" MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="About this test">
        <StackPanel Spacing="16">
          <TextBlock Text="About this test" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Actions are UI-only simulations. No files, cryptography, Go CLI, network or native bridge are involved." TextWrapping="Wrap" Classes="muted" LineHeight="24"/>
          <Button x:Name="CloseAboutButton" AutomationProperties.AutomationId="about-close" Content="Close" Command="{Binding CloseAboutCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
