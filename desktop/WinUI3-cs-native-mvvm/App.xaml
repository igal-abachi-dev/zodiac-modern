<?xml version="1.0" ?>
<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NeutronStar.WinUINative.App" RequestedTheme="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="BodyFont">ms-appx:///Assets/Fonts/inter-latin-400-normal.ttf#Inter, ms-appx:///Assets/Fonts/noto-sans-hebrew-hebrew-400-normal.ttf#Noto Sans Hebrew, Segoe UI Emoji</FontFamily>
      <FontFamily x:Key="HeadingFont">ms-appx:///Assets/Fonts/inter-latin-600-normal.ttf#Inter</FontFamily>
      <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#DCE3DE"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="32"/>
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>
      <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,16,0,0"/>
      </Style>
      <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="#047857"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#047857"/>
      </Style>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#DCE3DE"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
      </Style>
      <Style x:Key="Fixture" TargetType="Border">
        <Setter Property="Background" Value="#F1F4F2"/>
        <Setter Property="BorderBrush" Value="#DCE3DE"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="13"/>
        <Setter Property="MinHeight" Value="94"/>
      </Style>
      <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="#5D6660"/>
        <Setter Property="Margin" Value="0,20,0,9"/>
        <Setter Property="Text" Value="SYNTHETIC INPUT"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
