{
  "name": "neutronstar-electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "native/main.mjs",
  "description": "Independent Svelte desktop comparison application",
  "author": "Zodiac Modern contributors",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "pnpm build:assets && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig tsconfig.json",
    "test": "tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "build:assets": "node scripts/assets.mjs",
    "build": "pnpm typecheck && pnpm build:assets && vite build && node scripts/audit.mjs",
    "desktop:package": "pnpm format:check && pnpm test && pnpm build && pnpm build:notices && node scripts/package.mjs",
    "format:check": "prettier --check src native scripts tests vite.config.ts tsconfig.json package.json",
    "format": "prettier --write src native scripts tests vite.config.ts tsconfig.json package.json",
    "build:notices": "node scripts/notices.mjs",
    "test:runtime": "electron tests/runtime-smoke.mjs"
  },
  "dependencies": {
    "@ark-ui/svelte": "5.24.3",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-hebrew": "5.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/cli": "4.3.3",
    "electron": "45.0.0",
    "lucide-static": "1.58.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
