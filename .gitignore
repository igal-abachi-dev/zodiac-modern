# Key material is excluded by default, including encrypted private keys.
# Private keys and signing credentials belong outside this repository.
*.pem
*.der
*.key
*.p8
*.pk8
*.pkcs8
*.p12
*.pfx
*.jks
*.keystore
*.kdbx

# Reviewed public SPKI keys in the specified static-public location only.
!/public/keys/*-public.pem

# Synthetic test keys may be committed only in these explicit fixture locations.
# Fixture provenance/fingerprints and release-exclusion checks remain mandatory.
!/tests/fixtures/keys/*.pem
!/tests/fixtures/keys/*.der
!/receiver/tests/fixtures/keys/*.pem
!/receiver/tests/fixtures/keys/*.der

# Editor and OS-local files; shared VS Code configuration can be committed.
.idea/
.vscode/*
