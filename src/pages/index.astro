---
import Layout from '../layouts/Layout.astro';
import EncryptWorkbench from '../components/islands/EncryptWorkbench.svelte';
import { defaultRecipient } from '../generated/default-recipient';
---

<Layout title="Sender">
  <p class="eyebrow">A message under your chosen stars</p>
  <h1>
    Private words.
    <br />
    Celestial form.
  </h1>
  <p>
    Encrypt exact message bytes locally in your browser and download raw
    ciphertext. The recipient decrypts with a separate offline tool. Optional
    artwork is in development.
  </p>
  <EncryptWorkbench client:only="svelte" recipient={defaultRecipient}>
    <div slot="fallback" class="panel">
      The sender requires JavaScript, native WebCrypto and HTTPS or loopback.
      This development build is for synthetic messages only.
    </div>
  </EncryptWorkbench>
</Layout>
